# roman_urdu_translator - environment configuration
# Copy karein:  cp .env.example .env      (phir values bharein; .env gitignored hai)
# Load:         set -a; source .env; set +a
# Ya config.json use karein (config.example.json dekhein). Env vars hamesha jeette hain.

# ---------- Provider ----------
# openai (koi bhi OpenAI-compatible endpoint) | gemini | anthropic | mock
# mock = offline plumbing test, koi LLM nahi chalta
RU_PROVIDER=openai

# gpt-4o-mini (sasta+tez) | gpt-4o (behtar) | llama-3.3-70b-versatile (Groq, free)
# gemini-2.0-flash | claude-sonnet-4-5 | qwen2.5:7b (Ollama local)
RU_MODEL=gpt-4o-mini

# ---------- Credentials ----------
RU_API_KEY=

# OpenAI-compatible host badalna ho:
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   DeepInfra  https://api.deepinfra.com/v1/openai
#   Ollama     http://localhost:11434/v1
RU_BASE_URL=https://api.openai.com/v1

# ---------- Quality / behaviour ----------
RU_TEMPERATURE=0.2
RU_MAX_RETRIES=2
RU_TIMEOUT=60

# ---------- Card constraints ----------
# Rendered card ka per-line character cap. Chat/free-form text ke liye
# translate(..., max_line_len=None) pass karein.
RU_MAXLEN=118
# Kitne consecutive English words verbatim copy hone par line reject ho
# (4 = strict; 5 = technical phrases jaise "5 GW data centre" bach jate hain)
RU_PASTE_N=4

# ---------- HTTP server (server.py) ----------
PORT=8080
# Public internet par host kar rahe hain to zaroor set karein:
# har request par  Authorization: Bearer <token>  lazmi ho jayega
RU_SERVER_TOKEN=
